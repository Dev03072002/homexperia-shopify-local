# Copy to .env for local development. In production these are supplied by the
# host (AWS), with every secret coming from a secret manager rather than a file.
# Named env.example rather than .env.example because .gitignore excludes .env.*

# --- Shopify, provided by the CLI locally and by the app config in production ---

# Public client ID of the Shopify app. Not a secret.
SHOPIFY_API_KEY=

# SECRET. Signs OAuth exchanges and verifies webhook HMACs. Never expose.
SHOPIFY_API_SECRET=

# The app's public HTTPS origin. Must match application_url in shopify.app.production.toml
# and the OAuth redirect and webhook URLs registered with Shopify.
SHOPIFY_APP_URL=

# Comma-separated access scopes. Must agree with shopify.app.production.toml.
SCOPES=write_products,unauthenticated_read_product_listings,unauthenticated_read_product_inventory,unauthenticated_read_product_tags,unauthenticated_read_product_pickup_locations,unauthenticated_read_metaobjects

# --- Database ---

# SECRET. PostgreSQL connection string. Required by prisma/schema.prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/homexperia

# --- Homexperia integration ---

# SECRET. Shared bearer secret for POST /api/storefront-token. The Homexperia
# backend sends it as `Authorization: Bearer <value>`. If unset, the endpoint
# refuses all requests rather than falling open.
HOMEXPERIA_API_SECRET=

# The Homexperia experience URL opened in the PDP modal. NOT a secret — it ends
# up inside the public JS asset.
#
# BUILD-TIME variable. scripts/build-extension.mjs injects it into
# homexperia.min.js, which Shopify then serves from its CDN. It is NOT read at
# runtime, so changing it in AWS alone changes nothing on published storefronts.
# To roll out a new URL:  npm run deploy   (rebuilds the asset, then
# `shopify app deploy` publishes it). Must be https.
# Leave unset to fall back to the default in widget-src/homexperia.js.
# Base URL only — the extension appends /{shop}?productId=&shop=&variant= itself.
HOMEXPERIA_TARGET_URL=https://ai.homexperia.com/shopify-room-upload
