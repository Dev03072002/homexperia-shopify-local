// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per installed store, created only once a Storefront token exists.
// The row's existence is the provisioning state, so no status column is needed.
// Deleted on app/uninstalled, which is what stops the token API serving the shop.
model Shop {
  // The myshopify domain. Primary key, so reinstall upserts instead of duplicating.
  shop String @id

  // The credential the Homexperia backend fetches. This is a public-class
  // Storefront token, never an Admin token.
  storefrontAccessToken String

  // Shopify GID of the token, required to delete the superseded token on
  // rotation so the 100-tokens-per-shop ceiling can't creep.
  storefrontTokenGid String

  // The granted unauthenticated scopes this token was minted with, sorted and
  // comma-joined. Compared against currently granted scopes to decide whether
  // the token must be regenerated.
  storefrontScopes String
}
