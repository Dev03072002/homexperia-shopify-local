# Template for the production runtime env file.
#
#   /home/sopify/.config/homexperia-shopify/app.env
#
# This path is deliberately OUTSIDE /home/sopify/app so a Jenkins checkout or
# redeploy of the application directory can never overwrite or expose it.
#
# NEVER commit a filled-in copy of this file. Values come from the Jenkins
# Credentials Store at deploy time.
#
# Create with restrictive permissions:
#   install -m 600 /dev/null /home/sopify/.config/homexperia-shopify/app.env
#
# deploy.sh refuses to run unless this file is mode 600 or 400.

# --- Runtime configuration (not secret) ---

# Production Shopify app client ID. PENDING: the production Shopify app has not
# been created yet; this is currently only known for the development app.
SHOPIFY_API_KEY=

# Public origin of this application. Must match application_url and the
# redirect URL registered on the Shopify app.
SHOPIFY_APP_URL=https://shopify.homexperia.com

# Must match [access_scopes] scopes in shopify.app.production.toml exactly.
SCOPES=unauthenticated_read_product_listings,unauthenticated_read_product_inventory,unauthenticated_read_product_tags,unauthenticated_read_product_pickup_locations,unauthenticated_read_metaobjects

NODE_ENV=production

# Bind address and port. HOST=127.0.0.1 is important: the container runs with
# host networking, so binding 0.0.0.0 would expose the app on the EC2 network
# interface directly. Loopback keeps Nginx the only entry point.
HOST=127.0.0.1
PORT=3000

# --- Secrets (Jenkins Credentials Store) ---

# Shopify app client secret. Signs OAuth exchanges and verifies webhook HMACs.
# PENDING: production Shopify app not yet created.
SHOPIFY_API_SECRET=

# PostgreSQL on the EC2 host, reachable at 127.0.0.1 because the container uses
# host networking. Uses the dedicated non-superuser role that owns the database.
DATABASE_URL=postgresql://homexperia_shopify_app:PASSWORD@127.0.0.1:5432/homexperia_shopify

# Shared bearer secret the Homexperia backend sends to POST /api/storefront-token.
HOMEXPERIA_API_SECRET=

# --- Not used in production ---
#
# HOMEXPERIA_TARGET_URL is BUILD-TIME only. It is compiled into the theme app
# extension asset and served by Shopify's CDN, so setting it here has no effect.
# It belongs in the Jenkins extension-release job.
#
# SHOP_CUSTOM_DOMAIN and FRONTEND_PORT are development-only and should be unset.
