# macOS
.DS_Store

/.cache
/build
/app/build
/public/build/
/public/_dev
/app/public/build
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

.env
.env.*

# package-lock.json is intentionally tracked: the Dockerfile uses `npm ci`,
# which requires a lockfile, and reproducible installs matter for handover.
yarn.lock
pnpm-lock.yaml

/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Developer-specific Shopify app configurations stay local. The production
# config is the exception: it is tracked so CI has one deterministic target.
# Its client_id is the app's public identifier, not a secret.
shopify.app.*.toml
!shopify.app.production.toml

# Hide files auto-generated by react router
.react-router/

