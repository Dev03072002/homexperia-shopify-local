.env
.env.*

# package-lock.json is intentionally tracked: the Dockerfile uses `npm ci`,
# which requires a lockfile, and reproducible installs matter for handover.
yarn.lock
pnpm-lock.yaml

/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Developer-specific Shopify app configurations (shopify.app.<name>.toml).
# The shared shopify.app.toml is tracked but carries no client_id: local
# development uses `shopify app config use <name>`, and production releases
# supply the Client ID through SHOPIFY_FLAG_CLIENT_ID in Jenkins.
shopify.app.*.toml

# Hide files auto-generated by react router
.react-router/

